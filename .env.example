# Public Firebase web config (any non-empty values work with demo-prosefield locally)
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-prosefield.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-prosefield
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Server
APP_URL=http://localhost:3000
FIREBASE_PROJECT_ID=demo-prosefield
# Stripe test mode only — env.ts accepts sk_test_ / rk_test_ (rejects live keys).
# docker compose maps STRIPE_SECRET_KEY -> STRIPE_API_KEY for the stripe-cli service.
STRIPE_SECRET_KEY=sk_test_replaceme
STRIPE_WEBHOOK_SECRET=whsec_replaceme
STRIPE_PRICE_ID=price_replaceme
FEATURE_CUSTOMER_PORTAL=false
# Keep FEATURE_CUSTOMER_PORTAL=false until POST /api/billing/portal ships.
# The flag alone must not publish “Cancel anytime” claims (Art Direction 4.5).

# Plan display fallback (used when Stripe Price metadata is unavailable)
PLAN_DISPLAY_NAME=Prosefield
PLAN_DISPLAY_PRICE=8
PLAN_DISPLAY_CURRENCY=EUR
PLAN_DISPLAY_INTERVAL=month

# Emulators (optional). Point at the Docker backend when it is up.
# Leave unset or keep these defaults — the frontend still starts if the backend is down.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Required for `pnpm build` / `pnpm start` (NODE_ENV=production) against Docker
# emulators. Default OFF (commented) so copying this file for a real deploy does
# not disable the production emulator gate. Uncomment for local prod-mode, or
# export ALLOW_EMULATORS=1. CI and docker-compose set the flag explicitly.
# ALLOW_EMULATORS=1

# Document envelope encryption (AES-256-GCM). KEK never stored in Firebase.
# Local/CI: provider=dev and a 32-byte KEK (base64). The value below is the
# assembled local filler (32× 0x07) — replace for any non-local deploy.
# Production Cloud KMS keyring/key/IAM is Firebase Infra (Carlos approval).
DOCUMENT_ENCRYPTION_PROVIDER=dev
DOCUMENT_ENCRYPTION_KEY_VERSION=1
DOCUMENT_ENCRYPTION_KEK=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc=
# DOCUMENT_ENCRYPTION_KEK_PREVIOUS=
# DOCUMENT_ENCRYPTION_PROVIDER=kms
# GCP_KMS_KEY_NAME=projects/PROJECT/locations/LOCATION/keyRings/RING/cryptoKeys/KEY
