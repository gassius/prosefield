{
  "name": "prosefield",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:component": "vitest run --project component",
    "test:coverage": "vitest run --project unit --project component --coverage",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test --project=e2e --project=a11y",
    "test:e2e:offline": "playwright test e2e/offline.spec.ts --project=e2e",
    "test:visual": "bash scripts/test-visual.sh",
    "test:visual:update": "UPDATE=1 bash scripts/test-visual.sh",
    "backend:up": "bash scripts/require-docker.sh up -d --wait",
    "backend:down": "bash scripts/require-docker.sh down",
    "backend:logs": "bash scripts/require-docker.sh logs -f emulators"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@10.32.1"
}
