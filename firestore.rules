rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Architecture §5.6: browser clients never read or write. All document
    // access goes through Server Actions + the Admin SDK (bypasses rules).
    // Title (1–120 chars) and content (≤ 512 KiB UTF-8 bytes when serialised)
    // are enforced server-side in Zod (`src/features/documents/schemas.ts`),
    // not here — clients are not granted any create/update path that could
    // evaluate those bounds.
    match /documents/{documentId} {
      allow read: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
